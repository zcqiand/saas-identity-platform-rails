# saas-identity-platform-rails — rake test 期覆盖
#
# L4 测试期间 dotenv-rails 加载 .env.test → key 集合与 .env.example 一致。
# rails 直连库由本文件 PG_DATABASE 决定：测试链 = saas_test（家族三库分层，
# multi-repo-family.md §6.2）—— 与 springboot .env.test 值 saas_dev 有意不同：
# springboot 靠 profile 覆盖选库，rails 无 profile 机制。

# —— Server ——
SERVER_PORT=5106

# —— Database（saas_test 数据库, 全家族统一 PG_* 五件套） ——
PG_HOST=100.79.128.25
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=qiand68+++
PG_DATABASE=saas_test

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY) ——
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600

# —— CORS allowed origins (SSO 跨域用；test 链无 5101 vite dev) ——
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:5102,http://localhost:5103

# —— Rails session/verifier 密钥（rails 专属，test 链用 dev 值） ——
SECRET_KEY_BASE=dev-only-secret-key-base-not-for-production

# —— 兼容 deploy 脚本（键集相等契约；rails 运行时只读 PG_*） ——
DATABASE_URL=postgresql://postgres:qiand68%2B%2B%2B@100.79.128.25:5432/saas_test
DATABASE_NAME=saas_test

# —— 兼容 deploy 脚本（老 key） ——
DATABASE_USER=postgres
DATABASE_PASSWORD=qiand68+++
JWT_AUTHORITY=https://auth.example.com
