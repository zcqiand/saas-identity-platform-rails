# saas-identity-platform-rails — production 部署占位
#
# 进仓契约文件（L0.5 门管理）：真 secret 由 VPS env-file 注入；此处是 key 契约 + 占位值。
# key 集合与 .env.example 完全一致；值表语义：「key 契约 + 非 secret 已知 prod 值」。
# prod 域名 https://saas-rails.xiangru.uk（conventions §6.1，C3/D 阶段接 DNS/nginx）。

# —— Server ——
SERVER_PORT=5106

# —— Database（prod 库, 全家族统一 PG_* 五件套） ——
PG_HOST=…
PG_PORT=5432
PG_USER=…
PG_PASSWORD=…
PG_DATABASE=saas_prod

# —— JWT ——
JWT_SIGNING_KEY=…
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600

# —— CORS（prod 前端 origin 由 deploy 注入） ——
SAAS_CORS_ALLOWED_ORIGINS=…

# —— Rails session/verifier 密钥（rails 专属，deploy 首启自举随机值） ——
SECRET_KEY_BASE=…

# —— DATABASE_URL：ActiveRecord 一等连接真源（AR boot 无条件优先读本键，
# 空/占位值会让 rails 启动即 URI 崩）——deploy env-file 必须给合法 postgresql:// 形态；
# PG_* 五件套是 database.yml 的 fallback 形态（无 DATABASE_URL 时生效） ——
DATABASE_URL=postgresql://user:password@pg-host:5432/saas_prod
DATABASE_NAME=saas_prod

# —— 兼容 deploy 脚本（老 key） ——
DATABASE_USER=…
DATABASE_PASSWORD=…
JWT_AUTHORITY=…
